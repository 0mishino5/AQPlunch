{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**resto}" }
      },
      "identity-usuarios": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/usuarios/{**resto}" }
      },
      "identity-roles": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/roles/{**resto}" }
      },
      "restaurant-restaurantes": {
        "ClusterId": "restaurant",
        "Match": { "Path": "/api/restaurantes/{**resto}" }
      },
      "restaurant-mesas": {
        "ClusterId": "restaurant",
        "Match": { "Path": "/api/mesas/{**resto}" }
      },
      "restaurant-categorias": {
        "ClusterId": "restaurant",
        "Match": { "Path": "/api/categorias/{**resto}" }
      },
      "restaurant-productos": {
        "ClusterId": "restaurant",
        "Match": { "Path": "/api/productos/{**resto}" }
      },
      "order-pedidos": {
        "ClusterId": "order",
        "Match": { "Path": "/api/pedidos/{**resto}" }
      },
      "sales-ventas": {
        "ClusterId": "sales",
        "Match": { "Path": "/api/ventas/{**resto}" }
      },
      "sales-reportes": {
        "ClusterId": "sales",
        "Match": { "Path": "/api/reportes/{**resto}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-1": { "Address": "http://localhost:5001/" }
        }
      },
      "restaurant": {
        "Destinations": {
          "restaurant-1": { "Address": "http://localhost:5002/" }
        }
      },
      "order": {
        "Destinations": {
          "order-1": { "Address": "http://localhost:5003/" }
        }
      },
      "sales": {
        "Destinations": {
          "sales-1": { "Address": "http://localhost:5004/" }
        }
      }
    }
  }
}
